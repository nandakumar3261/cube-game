# Copy this file to .env and fill in your own values.
# Local MongoDB — default install listens here:
MONGO_URI=mongodb://127.0.0.1:27017/cubegame

# Any long random string — used to sign admin login tokens:
JWT_SECRET=change_this_to_a_long_random_string

# Port the API server runs on:
PORT=5000

# Used once by seedAdmin.js to create the first admin account:
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Thub@2758
